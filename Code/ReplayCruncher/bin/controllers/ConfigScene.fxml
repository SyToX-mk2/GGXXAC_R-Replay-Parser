<?import javafx.scene.control.Tooltip?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="154.0" prefWidth="538.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ConfigSceneController">
   <children>
      <GridPane layoutX="14.0" layoutY="14.0" prefHeight="93.0" prefWidth="521.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="128.0" minWidth="10.0" prefWidth="85.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="354.0" minWidth="10.0" prefWidth="354.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="95.0" minWidth="0.0" prefWidth="50.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Your Steam ID64:" />
            <TextField fx:id="txtMainSteamID" maxWidth="170.0" promptText="e.g. 76561198014254115" GridPane.columnIndex="1" >
               <tooltip>
			    	<Tooltip text="Your ID64 can be found by clicking your name in the upper-right corner of the main Steam UI window, then 'Account details', it'll be in the upper-left area, under your name." showDelay="200ms" showDuration="15000ms" />
			   </tooltip>
			</TextField>
            <Label text="Replay folder:" GridPane.rowIndex="1" />
            <TextField fx:id="txtRootFolder" prefHeight="25.0" prefWidth="339.0" promptText="e.g. C:\Documents\ARC SYSTEM WORKS\GGXXAC\Replays" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <tooltip>
			    	<Tooltip text="The root folder where the game stores your replays, the default should be 'C:\Users\[YOUR USER NAME]\Documents\ARC SYSTEM WORKS\GGXXAC\Replays'. Your replays will be organized here." showDelay="200ms" showDuration="15000ms" />
			   </tooltip>
			</TextField>
            <Button fx:id="btnBrowse" mnemonicParsing="false" onAction="#handleBrowseFolder" text="Browse" GridPane.columnIndex="2" GridPane.rowIndex="1">
               <GridPane.margin>
                  <Insets left="10.0" />
               </GridPane.margin>
            </Button>
         </children>
      </GridPane>
      <HBox layoutX="417.0" layoutY="115.0" prefHeight="25.0" prefWidth="107.0" spacing="10.0">
         <children>
            <Button fx:id="btnSaveConfig" mnemonicParsing="false" onAction="#handleSave" text="Save" />
            <Button fx:id="btnCancelSetup" mnemonicParsing="false" onAction="#handleCancelSetup" text="Cancel" />
         </children>
      </HBox>
   </children>
</AnchorPane>
